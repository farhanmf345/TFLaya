# ============================================================
#  TenderFlow v4.0 - Example Environment File
#  Copy this file to .env and fill in your actual values.
#  NEVER commit .env to version control.
# ============================================================


# ─── Database (MySQL) ────────────────────────────────────────
DB_URL=mysql+pymysql://root:your_password@localhost:3306/tenderflow_v4
# Optional: individual parts (if your config loader uses them)
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=tenderflow_v4
# DB_USER=root
# DB_PASSWORD=your_password


# ─── Google Gemini API ───────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash          # or gemini-1.5-pro, etc.


# ─── ChromaDB (Vector Store) ─────────────────────────────────
CHROMA_PATH=./chroma_data
# CHROMA_HOST=localhost              # if using remote ChromaDB server
# CHROMA_PORT=8000


# ─── SMTP / Email Notifications ──────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password        # Use an App Password, not your account password
EMAIL_FROM_NAME=TenderFlow
EMAIL_FROM_ADDRESS=your_email@gmail.com


# ─── FastAPI / App Settings ──────────────────────────────────
APP_SECRET_KEY=change_this_to_a_long_random_secret_key
DEBUG=True                             # Set to False in production
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=info                         # debug | info | warning | error


# ─── CORS ────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173


# ─── Scheduler (APScheduler) ─────────────────────────────────
SCRAPE_CRON_HOUR=2                     # Hour (24h) to run daily scrape job
SCRAPE_CRON_MINUTE=0


# ─── Frontend (Vite / React) ─────────────────────────────────
# Variables must be prefixed with VITE_ to be exposed to the browser
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_NAME=TenderFlow

# ─── Microsoft Azure AD (MSAL) ───────────────────────────────
# Get these from: Azure Portal → App Registrations → Your App
VITE_AZURE_CLIENT_ID=your-azure-app-client-id
VITE_AZURE_TENANT_ID=your-azure-tenant-id
# Leave blank to default to window.location.origin (works for local dev)
VITE_REDIRECT_URI=http://localhost:5173