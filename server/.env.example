# TenderFlow v4.0 Backend
# ========================

# DB_URL format for Supabase PostgreSQL:
# postgresql+psycopg2://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DB_URL=postgresql+psycopg2://postgres.[project-ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
GEMINI_API_KEY=your_gemini_api_key_here

# SMTP Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM_NAME=TenderFlow

# Tender requirement classifier: off | laya | gemini  (laya needs: pip install laya)
REQUIREMENTS_BACKEND=laya
REQUIREMENTS_CONFIDENCE=0.7

# ChromaDB
CHROMA_PATH=./chroma_data

# App
DEBUG=True
CORS_ORIGINS=http://localhost:5173
